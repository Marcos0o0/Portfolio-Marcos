---
import { DotGrid } from "@/components/ui/DotGrid.jsx";
import { SplitText } from "@/components/ui/SplitText.jsx";

export interface Props {
  email?: string;
  ubicacion?: string;
  redes?: {
    github?: string;
    linkedin?: string;
    twitter?: string;
    instagram?: string;
    dribbble?: string;
  };
}

const {
  email = "mgodoy2025@alu.uct.cl",
  ubicacion = "Temuco, Chile",
  redes = {},
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<style>
  .footer-wrapper {
    padding: 2rem 1rem;
    position: relative;
  }

  .footer-card {
    position: relative;
    overflow: hidden;
    min-height: 700px;
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(20, 20, 30, 0.6);
    backdrop-filter: blur(20px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .ballpit-container {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: 32px;
  }

  .footer-content {
    position: relative;
    z-index: 10;
    padding: 4rem 2rem;
  }

  .contact-title {
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(255, 255, 255, 0.6) 100%
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(255, 255, 255, 0.2));
  }

  .contact-subtitle {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.25rem;
    margin-bottom: 3rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .bento-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 32px;
    backdrop-filter: blur(10px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: auto;
    position: relative;
    overflow: hidden;
  }

  .bento-box::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(138, 43, 226, 0.05),
      rgba(75, 0, 130, 0.05)
    );
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .bento-box:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(138, 43, 226, 0.4);
    transform: translateY(-4px);
  }

  .bento-box:hover::before {
    opacity: 1;
  }

  /* Hero CTA Box - Grande y destacado */
  .bento-hero {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 280px;
    background: linear-gradient(
      135deg,
      rgba(138, 43, 226, 0.1),
      rgba(75, 0, 130, 0.1)
    );
    border: 2px solid rgba(138, 43, 226, 0.3);
  }

  .bento-hero:hover {
    border-color: rgba(138, 43, 226, 0.6);
    background: linear-gradient(
      135deg,
      rgba(138, 43, 226, 0.15),
      rgba(75, 0, 130, 0.15)
    );
  }

  /* Email Box */
  .bento-email {
    grid-column: span 12;
  }

  /* Location Box */
  .bento-location {
    grid-column: span 12;
  }

  /* Social Box - Más ancho */
  .bento-social {
    grid-column: span 12;
    padding: 32px;
  }

  @media (min-width: 768px) {
    .bento-hero {
      grid-column: span 12;
      min-height: 320px;
    }

    .bento-email {
      grid-column: span 6;
    }

    .bento-location {
      grid-column: span 6;
    }

    .bento-social {
      grid-column: span 12;
    }
  }

  @media (min-width: 1024px) {
    .bento-email {
      grid-column: span 5;
    }

    .bento-location {
      grid-column: span 4;
    }

    .bento-social {
      grid-column: span 3;
      padding: 32px 24px;
    }
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 20px 48px;
    background: linear-gradient(
      135deg,
      rgba(138, 43, 226, 0.9),
      rgba(75, 0, 130, 0.9)
    );
    border: 2px solid rgba(138, 43, 226, 0.6);
    border-radius: 16px;
    color: white;
    font-size: 1.125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(10px);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(138, 43, 226, 0.3);
  }

  .cta-button:hover {
    background: linear-gradient(
      135deg,
      rgba(138, 43, 226, 1),
      rgba(75, 0, 130, 1)
    );
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(138, 43, 226, 0.5);
    border-color: rgba(138, 43, 226, 0.8);
  }

  .cta-button:active {
    transform: translateY(-2px);
  }

  .box-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(
      135deg,
      rgba(138, 43, 226, 0.2),
      rgba(75, 0, 130, 0.2)
    );
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bento-box:hover .box-icon {
    background: linear-gradient(
      135deg,
      rgba(138, 43, 226, 0.4),
      rgba(75, 0, 130, 0.4)
    );
    transform: scale(1.1) rotate(5deg);
  }

  .box-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
    margin-bottom: 12px;
  }

  .box-value {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .box-value:hover {
    color: rgba(138, 43, 226, 0.8);
    transform: translateX(4px);
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .social-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    color: rgba(255, 255, 255, 0.7);
    position: relative;
    z-index: 20;
    pointer-events: auto;
  }

  .social-item:hover {
    background: rgba(138, 43, 226, 0.2);
    border-color: rgba(138, 43, 226, 0.5);
    color: white;
    transform: scale(1.05);
  }

  .hero-text {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 600px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .footer-bottom {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .contact-title {
      font-size: 2.5rem;
    }

    .footer-card {
      min-height: auto;
      border-radius: 24px;
    }

    .footer-content {
      padding: 3rem 1.5rem;
    }

    .footer-wrapper {
      padding: 1rem 0.5rem;
    }

    .bento-box {
      padding: 24px;
    }

    .hero-text {
      font-size: 1rem;
    }

    .social-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<footer class="footer-wrapper">
  <div class="footer-card">
    <!-- Ballpit Background -->
    <div class="ballpit-container">
      <DotGrid
        client:load
        dotSize={5}
        gap={15}
        baseColor="#271e37"
        activeColor="#734f9a"
        proximity={120}
        shockRadius={250}
        shockStrength={5}
        resistance={750}
        returnDuration={1.5}
      />
    </div>

    <!-- Content -->
    <div class="footer-content">
      <div class="container mx-auto max-w-7xl">
        <!-- Title -->
        <div class="w-full flex justify-center pb-8">
          <SplitText
            client:load
            text="Let's Work Together"
            className="contact-title text-8xl font-doppel text-light-purple"
            delay={100}
            duration={0.6}
            ease="power3.out"
            splitType="chars"
            from={{ opacity: 0, y: 40 }}
            to={{ opacity: 1, y: 0 }}
            threshold={0.1}
            rootMargin="-100px"
          />
        </div>

        <!-- Bento Grid -->
        <div class="bento-grid pt-8">
          <!-- Hero CTA Box -->
          <div class="bento-box bento-hero" data-reveal>
            <p class="hero-text font-spac">
              ¿Listo para dar vida a tu próximo proyecto? Cuéntame tu idea y
              trabajemos juntos para crear algo increíble.
            </p>
            <a href={`mailto:${email}`} class="cta-button font-spac">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              Enviar Email
            </a>
          </div>

          <!-- Email Box -->
          <div class="bento-box bento-email font-spac" data-reveal data-reveal-delay="100">
            <div class="box-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-purple-300"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div class="box-label">Email</div>
            <a href={`mailto:${email}`} class="box-value">
              {email}
            </a>
          </div>

          <!-- Location Box -->
          <div class="bento-box bento-location font-spac" data-reveal data-reveal-delay="200">
            <div class="box-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-purple-300"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="box-label">Ubicación</div>
            <div class="box-value" style="cursor: default; transform: none;">
              {ubicacion}
            </div>
          </div>

          <!-- Social Box -->
          {
            Object.keys(redes).length > 0 && (
              <div class="bento-box bento-social font-spac">
                <div class="box-label" style="margin-bottom: 20px;">
                  Sígueme
                </div>
                <div class="social-grid" data-stagger>
                  {redes.github && (
                    <a
                      href={redes.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-item"
                      aria-label="GitHub"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                      </svg>
                    </a>
                  )}
                  {redes.linkedin && (
                    <a
                      href={redes.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-item"
                      aria-label="LinkedIn"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                      </svg>
                    </a>
                  )}
                  {redes.twitter && (
                    <a
                      href={redes.twitter}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-item"
                      aria-label="Twitter/X"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                    </a>
                  )}
                  {redes.instagram && (
                    <a
                      href={redes.instagram}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-item"
                      aria-label="Instagram"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                      </svg>
                    </a>
                  )}
                  {redes.dribbble && (
                    <a
                      href={redes.dribbble}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="social-item"
                      aria-label="Dribbble"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M12 0c-6.628 0-12 5.373-12 12s5.372 12 12 12 12-5.373 12-12-5.372-12-12-12zm9.885 11.441c-2.575-.422-4.943-.445-7.103-.073-.244-.563-.497-1.125-.767-1.68 2.31-1 4.165-2.358 5.548-4.082 1.35 1.594 2.197 3.619 2.322 5.835zm-3.842-7.282c-1.205 1.554-2.868 2.783-4.986 3.68-1.016-1.861-2.178-3.676-3.488-5.438.779-.197 1.591-.314 2.431-.314 2.275 0 4.368.779 6.043 2.072zm-10.516-.993c1.331 1.742 2.511 3.538 3.537 5.381-2.43.715-5.331 1.082-8.684 1.105.692-2.835 2.601-5.193 5.147-6.486zm-5.44 8.834l.013-.256c3.849-.005 7.169-.448 9.95-1.322.233.475.456.952.67 1.432-3.38 1.057-6.165 3.222-8.337 6.48-1.432-1.719-2.296-3.927-2.296-6.334zm3.829 7.81c1.969-3.088 4.482-5.098 7.598-6.027.928 2.42 1.609 4.91 2.043 7.46-3.349 1.291-7.235.790-9.641-1.433zm11.586.43c-.438-2.353-1.08-4.653-1.92-6.897 1.876-.265 3.94-.196 6.199.196-.437 2.786-2.028 5.192-4.279 6.701z" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            )
          }
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom font-spac">
          <p>© {currentYear} Marcos Godoy. Todos los derechos reservados.</p>
        </div>
      </div>
    </div>
  </div>
</footer>
