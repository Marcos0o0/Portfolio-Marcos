<style>
  .logo-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
  }

  svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 30px rgba(150, 95, 212, 0.4));
  }

  /* Ocultar paths inicialmente */
  svg path {
    opacity: 0;
  }
</style>

<script>
  import { animate } from 'animejs';

  if (typeof window !== 'undefined') {
    window.addEventListener('DOMContentLoaded', () => {
      const paths = document.querySelectorAll('#animated-logo path');
      
      paths.forEach((path, index) => {
        const length = path.getTotalLength();
        
        // Guardar el color original del fill
        const originalFill = path.getAttribute('fill') || '#965FD4';
        
        // Configurar para animación de escritura
        path.style.fill = 'none';  // Sin relleno inicialmente
        path.style.stroke = originalFill;  // Contorno con el color
        path.style.strokeWidth = '2';
        path.style.strokeLinecap = 'round';
        path.style.strokeLinejoin = 'round';
        path.style.strokeDasharray = length.toString();
        path.style.strokeDashoffset = length.toString();
        
        // Animación 1: Dibujar el contorno (escritura)
        animate(path, {
          strokeDashoffset: [length, 0],
          duration: 1500,
          delay: index * 200,
          ease: 'out(3)',
          complete: () => {
            // Animación 2: Agregar el relleno después de dibujar
            animate(path, {
              fill: ['rgba(150, 95, 212, 0)', originalFill],
              duration: 400,
              ease: 'out(2)',
              complete: () => {
                // Opcional: quitar el stroke después del relleno
                animate(path, {
                  strokeWidth: [2, 0],
                  duration: 300,
                  ease: 'out'
                });
              }
            });
          }
        });
      });

      // Efecto de brillo continuo
      setTimeout(() => {
        animate('#animated-logo', {
          filter: [
            'drop-shadow(0 0 20px rgba(150, 95, 212, 0.3))',
            'drop-shadow(0 0 40px rgba(150, 95, 212, 0.7))',
            'drop-shadow(0 0 20px rgba(150, 95, 212, 0.3))'
          ],
          duration: 2000,
          ease: 'inOut',
          loop: true
        });
      }, paths.length * 200 + 2000);
    });
  }
</script>