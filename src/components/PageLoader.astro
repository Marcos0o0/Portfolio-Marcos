---
// src/components/PageLoader.astro
---

<!-- Curtain panels (behind loader during loading, revealed on exit) -->
<div id="loader-curtain-top"></div>
<div id="loader-curtain-bottom"></div>

<div id="page-loader">
  <!-- Mesh Gradient Background -->
  <canvas id="loader-canvas"></canvas>

  <!-- Corner metadata — editorial feel -->
  <span class="loader-meta meta-tl">MG</span>
  <span class="loader-meta meta-tr">©2026</span>
  <span class="loader-meta meta-bl">DEVELOPER &amp; DESIGNER</span>
  <span class="loader-meta meta-br">PORTFOLIO</span>

  <!-- Center content -->
  <div id="loader-content">
    <!-- Decorative rotating sparkle -->
    <div class="loader-sparkle">
      <img src="/Sparkle.svg" alt="" width="28" height="28" />
    </div>

    <!-- Counter -->
    <div class="counter-wrapper">
      <div id="loader-counter">000</div>
    </div>

    <!-- Expanding line -->
    <div class="loader-line-track">
      <div class="loader-line" id="loader-line"></div>
    </div>
  </div>
</div>

<style>
  /* ── Curtain panels ── */
  #loader-curtain-top,
  #loader-curtain-bottom {
    position: fixed;
    left: 0;
    width: 100%;
    height: 50vh;
    height: 50dvh;
    background: #080611;
    z-index: 99998;
    pointer-events: none;
    will-change: transform;
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
  }

  #loader-curtain-top {
    top: 0;
  }

  #loader-curtain-bottom {
    bottom: 0;
  }

  #loader-curtain-top.open {
    transform: translateY(-100%);
  }

  #loader-curtain-bottom.open {
    transform: translateY(100%);
  }

  #loader-curtain-top.done,
  #loader-curtain-bottom.done {
    display: none;
  }

  /* ── Loader container ── */
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #080611;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #loader-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.85;
  }

  /* ── Corner metadata ── */
  .loader-meta {
    position: absolute;
    z-index: 6;
    font-family: var(--font-spac, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.25);
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .loader-meta.visible {
    opacity: 1;
  }

  .meta-tl {
    top: 2rem;
    left: 2.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
  }

  .meta-tr {
    top: 2rem;
    right: 2.5rem;
  }

  .meta-bl {
    bottom: 2rem;
    left: 2.5rem;
  }

  .meta-br {
    bottom: 2rem;
    right: 2.5rem;
  }

  /* ── Center content ── */
  #loader-content {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  /* ── Sparkle ── */
  .loader-sparkle {
    opacity: 0;
    animation: sparkle-in 0.8s ease-out 0.3s forwards;
  }

  .loader-sparkle svg {
    animation: sparkle-spin 6s linear infinite;
    filter: drop-shadow(0 0 8px rgba(150, 95, 212, 0.4));
  }

  @keyframes sparkle-in {
    from {
      opacity: 0;
      transform: scale(0) rotate(-90deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes sparkle-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ── Counter ── */
  .counter-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #loader-counter {
    font-family: var(--font-garamond, sans-serif);
    font-size: clamp(7rem, 20vw, 14rem);
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums lining-nums;
    text-shadow: 0 0 60px rgba(150, 95, 212, 0.25);
    opacity: 0;
    transform: translateY(20px);
    animation: counter-in 0.8s ease-out 0.1s forwards;
  }

  @keyframes counter-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Expanding line ── */
  .loader-line-track {
    width: 200px;
    height: 1px;
    position: relative;
    overflow: hidden;
    opacity: 0;
    animation: line-in 0.6s ease-out 0.5s forwards;
  }

  @keyframes line-in {
    to {
      opacity: 1;
    }
  }

  .loader-line {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 100%;
    width: 0%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(150, 95, 212, 0.8),
      transparent
    );
    transition: width 0.15s linear;
  }

  /* ── Exit: Phase 1 — content fades ── */
  #page-loader.exit-content #loader-content {
    opacity: 0;
    filter: blur(30px);
    transform: scale(1.15);
    transition: all 0.7s cubic-bezier(0.76, 0, 0.24, 1);
  }

  #page-loader.exit-content .loader-meta {
    opacity: 0 !important;
    transition: opacity 0.4s ease !important;
  }

  #page-loader.exit-content #loader-canvas {
    opacity: 0;
    transition: opacity 0.6s ease 0.1s;
  }

  /* ── Exit: Phase 2 — loader hides, curtains take over ── */
  #page-loader.exit-hide {
    visibility: hidden;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .meta-tl {
      top: 1.5rem;
      left: 1.5rem;
    }
    .meta-tr {
      top: 1.5rem;
      right: 1.5rem;
    }
    .meta-bl {
      bottom: 1.5rem;
      left: 1.5rem;
    }
    .meta-br {
      bottom: 1.5rem;
      right: 1.5rem;
    }
  }
</style>

<script>
  (function () {
    const loader = document.getElementById("page-loader");
    const canvas = document.getElementById(
      "loader-canvas",
    ) as HTMLCanvasElement;
    const counter = document.getElementById("loader-counter");
    const line = document.getElementById("loader-line");
    const metaItems = document.querySelectorAll(".loader-meta");
    const curtainTop = document.getElementById("loader-curtain-top");
    const curtainBottom = document.getElementById("loader-curtain-bottom");

    if (!loader || !canvas || !counter || !line) return;

    // Show corner metadata with stagger
    metaItems.forEach((el, i) => {
      setTimeout(() => el.classList.add("visible"), 600 + i * 200);
    });

    /* ─── WEBGL MESH SHADER ──────────────────────────────────── */
    const gl =
      canvas.getContext("webgl") ||
      (canvas.getContext("experimental-webgl") as WebGLRenderingContext | null);
    if (gl) {
      const resize = () => {
        canvas.width = window.innerWidth * Math.min(window.devicePixelRatio, 2);
        canvas.height =
          window.innerHeight * Math.min(window.devicePixelRatio, 2);
        gl.viewport(0, 0, canvas.width, canvas.height);
      };
      resize();
      window.addEventListener("resize", resize, { passive: true });

      const VERT = `attribute vec2 p; void main() { gl_Position = vec4(p, 0, 1); }`;
      const FRAG = `
        precision highp float;
        uniform float t; uniform vec2 r;
        
        vec3 m3(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
        vec4 m4(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
        vec4 pm(vec4 x) { return m4(((x * 34.0) + 1.0) * x); }
        vec4 ti(vec4 r) { return 1.7928429 - 0.8537347 * r; }

        float sn(vec3 v) {
          const vec2 C = vec2(1.0/6.0, 1.0/3.0); const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
          vec3 i = floor(v + dot(v, C.yyy)), x0 = v - i + dot(i, C.xxx);
          vec3 g = step(x0.yzx, x0.xyz), l = 1.0 - g, i1 = min(g.xyz, l.zxy), i2 = max(g.xyz, l.zxy);
          vec3 x1 = x0 - i1 + C.xxx, x2 = x0 - i2 + C.yyy, x3 = x0 - D.yyy;
          i = m3(i);
          vec4 p = pm(pm(pm(i.z + vec4(0.0, i1.z, i2.z, 1.0)) + i.y + vec4(0.0, i1.y, i2.y, 1.0)) + i.x + vec4(0.0, i1.x, i2.x, 1.0));
          vec3 ns = 0.142857142857 * D.wyz - D.xzx;
          vec4 j = p - 49.0 * floor(p * ns.z * ns.z), x_ = floor(j * ns.z), y_ = floor(j - 7.0 * x_);
          vec4 x2a = x_ * ns.x + ns.yyyy, y2a = y_ * ns.x + ns.yyyy, h = 1.0 - abs(x2a) - abs(y2a);
          vec4 b0 = vec4(x2a.xy, y2a.xy), b1 = vec4(x2a.zw, y2a.zw);
          vec4 s0 = floor(b0) * 2.0 + 1.0, s1 = floor(b1) * 2.0 + 1.0, sh = -step(h, vec4(0.0));
          vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy, a1 = b1.xzyw + s1.xzyw * sh.zzww;
          vec3 p0v = vec3(a0.xy, h.x), p1v = vec3(a0.zw, h.y), p2v = vec3(a1.xy, h.z), p3v = vec3(a1.zw, h.w);
          vec4 nm = ti(vec4(dot(p0v,p0v), dot(p1v,p1v), dot(p2v,p2v), dot(p3v,p3v)));
          p0v *= nm.x; p1v *= nm.y; p2v *= nm.z; p3v *= nm.w;
          vec4 mm = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0); mm = mm * mm;
          return 42.0 * dot(mm * mm, vec4(dot(p0v,x0), dot(p1v,x1), dot(p2v,x2), dot(p3v,x3)));
        }

        void main() {
          vec2 uv = gl_FragCoord.xy / r; float ar = r.x / r.y; vec2 p2 = uv * vec2(ar, 1.0);
          float s = t * 0.15;
          float n = sn(vec3(p2 * 0.8, s));
          
          vec3 c1 = vec3(0.03, 0.02, 0.08);
          vec3 c2 = vec3(0.12, 0.05, 0.25);
          vec3 c3 = vec3(0.35, 0.15, 0.55);
          
          float m1 = smoothstep(-0.2, 0.8, sn(vec3(p2 * 1.2, s * 0.5)));
          float m2 = smoothstep(-0.5, 0.5, sn(vec3(p2 * 0.5, s * 0.8 + 2.0)));
          
          vec3 c = mix(c1, c2, m1);
          c = mix(c, c3, m2 * 0.4);
          c += (n * 0.02);
          
          float v = 1.0 - smoothstep(0.2, 1.2, length((uv - 0.5) * 1.5));
          gl_FragColor = vec4(c * v, 1.0);
        }
      `;

      const mk = (type: number, src: string) => {
        const s = gl.createShader(type)!;
        gl.shaderSource(s, src);
        gl.compileShader(s);
        return s;
      };
      const prog = gl.createProgram()!;
      gl.attachShader(prog, mk(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, mk(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
      gl.useProgram(prog);

      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
        gl.STATIC_DRAW,
      );
      const aPos = gl.getAttribLocation(prog, "p");
      gl.enableVertexAttribArray(aPos);
      gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

      const uT = gl.getUniformLocation(prog, "t"),
        uR = gl.getUniformLocation(prog, "r");
      const t0 = performance.now();
      let rafGL: number;
      const draw = () => {
        gl.uniform1f(uT, (performance.now() - t0) / 1000);
        gl.uniform2f(uR, canvas.width, canvas.height);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        rafGL = requestAnimationFrame(draw);
      };
      draw();
      (window as any)._loaderStopGL = () => cancelAnimationFrame(rafGL);
    }

    /* ─── ANIMATION SEQUENCE ──────────────────────────────────── */
    let val = 0;
    const start = performance.now();
    const duration = 2800;

    const update = (now: number) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);

      // Stronger ease-out for counter
      const eased = 1 - Math.pow(1 - progress, 4);
      val = Math.floor(eased * 100);

      counter.textContent = val.toString().padStart(3, "0");
      line.style.width = progress * 100 + "%";

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        maybeExit();
      }
    };
    requestAnimationFrame(update);

    const maybeExit = () => {
      if (document.readyState === "complete") {
        triggerExit();
      } else {
        window.addEventListener("load", triggerExit, { once: true });
      }
    };

    const triggerExit = () => {
      // Phase 1: Content fades out (blur + scale + opacity)
      loader.classList.add("exit-content");

      // Phase 2: After content fades, hide loader and open curtains
      setTimeout(() => {
        loader.classList.add("exit-hide");
        if (typeof (window as any)._loaderStopGL === "function")
          (window as any)._loaderStopGL();

        // Open curtains (top slides up, bottom slides down)
        if (curtainTop) curtainTop.classList.add("open");
        if (curtainBottom) curtainBottom.classList.add("open");

        // Phase 3: After curtains finish, clean up and dispatch
        setTimeout(() => {
          if (curtainTop) curtainTop.classList.add("done");
          if (curtainBottom) curtainBottom.classList.add("done");
          document.body.style.overflow = "";

          // NOW dispatch — after everything is visually gone
          document.documentElement.classList.add("loader-finished");
          document.dispatchEvent(new CustomEvent("loader-finished"));
        }, 1000);
      }, 700);
    };

    document.body.style.overflow = "hidden";
  })();
</script>
