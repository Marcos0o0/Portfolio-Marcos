---
import {
  siReact,
  siTypescript,
  siAstro,
  siTailwindcss,
  siNodedotjs,
  siFigma,
  siMongodb,
  siGit,
  siGithub,
  siVercel,
} from "simple-icons";

export interface Props {
  projects?: {
    titulo: string;
    descripcion: string;
    tags: string[];
    imagen?: string;
    enlace: string;
    año?: string;
  }[];
}
const { projects = [] } = Astro.props;
---

<section
  id="projects"
  class="projects-section relative bg-base border-x-10 border-[#0e0c16] overflow-hidden"
>
  <!-- Cursor: siempre visible en la sección, "VER" solo en hover de card -->
  <div class="custom-cursor" id="projectCursor">
    <span class="cursor-label">VER</span>
  </div>

  <!-- Header editorial -->
  <div class="projects-header">
    <div class="projects-eyebrow">
      <span class="eyebrow-line"></span>
      <span class="eyebrow-text">Trabajo selecto</span>
    </div>
    <div class="projects-title-block">
      <h2 class="projects-main-title" data-reveal>Projects</h2>
      <p class="projects-count">
        ( {String(projects.length).padStart(2, "0")} )
      </p>
    </div>
  </div>

  <!-- Track horizontal scrollable -->
  <div class="projects-track-wrapper">
    <div class="projects-track" id="projectsTrack">
      {
        projects.map((project, i) => (
          <a
            href={project.enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="project-item"
            data-project-item
          >
            <div class="project-index">{String(i + 1).padStart(2, "0")}</div>

            <div class="project-visual">
              {project.imagen ? (
                <img
                  src={project.imagen}
                  alt={project.titulo}
                  class="project-img"
                  loading="lazy"
                />
              ) : (
                <div class="project-img-placeholder">
                  <div class="placeholder-grid">
                    {Array.from({ length: 9 }).map(() => (
                      <div class="grid-dot" />
                    ))}
                  </div>
                </div>
              )}
              <div class="project-visual-overlay" />
            </div>

            <div class="project-info">
              <div class="project-meta">
                <span class="project-year">{project.año ?? "2024"}</span>
                <div class="project-tags-row">
                  {project.tags.slice(0, 3).map((tag) => {
                    let iconData;
                    switch (tag.toLowerCase()) {
                      case "react":
                        iconData = siReact;
                        break;
                      case "typescript":
                        iconData = siTypescript;
                        break;
                      case "astro":
                        iconData = siAstro;
                        break;
                      case "tailwind":
                      case "tailwind css":
                        iconData = siTailwindcss;
                        break;
                      case "api":
                      case "node":
                      case "node.js":
                        iconData = siNodedotjs;
                        break;
                      case "mongodb":
                        iconData = siMongodb;
                        break;
                      case "git":
                        iconData = siGit;
                        break;
                      case "github":
                        iconData = siGithub;
                        break;
                      case "vercel":
                        iconData = siVercel;
                        break;
                      case "figma":
                        iconData = siFigma;
                        break;
                    }
                    const isDarkIcon =
                      iconData?.hex === "000000" || iconData?.hex === "181717";
                    const fillColor = isDarkIcon ? "FFFFFF" : iconData?.hex;

                    return (
                      <span
                        class="project-tag-pill"
                        style={{ display: "inline-flex", alignItems: "center" }}
                      >
                        {iconData && (
                          <span
                            class="project-tag-icon"
                            style={{
                              display: "inline-flex",
                              marginRight: "5px",
                            }}
                            set:html={`<svg viewBox="0 0 24 24" fill="#${fillColor}" width="10" height="10"><path d="${iconData.path}"/></svg>`}
                          />
                        )}
                        {tag}
                      </span>
                    );
                  })}
                </div>
              </div>
              <h3 class="project-title">{project.titulo}</h3>
              <p class="project-desc">{project.descripcion}</p>
              <div class="project-cta">
                <span class="cta-text">Explorar</span>
                <span class="cta-arrow">→</span>
              </div>
            </div>
          </a>
        ))
      }
      <div class="track-end-spacer"></div>
    </div>
  </div>

  <div class="scroll-progress-bar">
    <div class="scroll-progress-fill" id="scrollFill"></div>
  </div>

  <div class="scroll-hint" id="scrollHint">
    <span>Arrastra o desplaza</span>
    <div class="hint-arrows"><span>←</span><span>→</span></div>
  </div>
</section>

<style>
  .projects-section,
  .projects-section * {
    cursor: none !important;
  }

  .projects-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Cursor: círculo siempre visible, label solo en hover de card ── */
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #965fd4;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%) scale(0);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.2s ease;
    opacity: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: left, top;
  }

  .cursor-label {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s ease;
    font-family: var(--font-spac, monospace);
  }

  /* Visible dentro de la sección */
  .custom-cursor.visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  /* "VER" aparece solo cuando está sobre una card */
  .custom-cursor.on-card .cursor-label {
    opacity: 1;
  }

  .custom-cursor.clicking {
    transform: translate(-50%, -50%) scale(0.85);
  }

  /* ── Header ─────────────────────────────────────────────────── */
  .projects-header {
    padding: 7rem 3rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  .projects-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .eyebrow-line {
    display: block;
    width: 40px;
    height: 1px;
    background: rgba(150, 95, 212, 0.6);
  }

  .eyebrow-text {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(150, 95, 212, 0.7);
    font-family: var(--font-spac, monospace);
  }

  .projects-title-block {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .projects-main-title {
    font-family: var(--font-garamond, serif);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 400;
    color: #fff;
    line-height: 0.9;
    margin: 0;
    letter-spacing: -0.02em;
    font-style: italic;
  }

  .projects-count {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.3);
    font-family: var(--font-spac, monospace);
    align-self: flex-end;
    margin-bottom: 0.5rem;
  }

  /* ── Track ───────────────────────────────────────────────────── */
  .projects-track-wrapper {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2rem 3rem 3rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .projects-track-wrapper::-webkit-scrollbar {
    display: none;
  }

  .projects-track {
    display: flex;
    gap: 2px;
    height: 520px;
    width: max-content;
  }

  /* ── Cards ───────────────────────────────────────────────────── */
  .project-item {
    position: relative;
    width: 380px;
    height: 100%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.02);
    transition:
      border-color 0.4s ease,
      background 0.4s ease;
  }

  .project-item:hover {
    border-color: rgba(150, 95, 212, 0.35);
    background: rgba(150, 95, 212, 0.04);
  }

  .project-index {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.2);
    font-family: var(--font-spac, monospace);
    z-index: 3;
    transition: color 0.3s ease;
  }

  .project-item:hover .project-index {
    color: rgba(150, 95, 212, 0.8);
  }

  .project-visual {
    position: relative;
    width: 100%;
    height: 260px;
    flex-shrink: 0;
    overflow: hidden;
    background: rgba(150, 95, 212, 0.06);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      filter 0.5s ease;
    filter: grayscale(30%) brightness(0.85);
  }

  .project-item:hover .project-img {
    transform: scale(1.06);
    filter: grayscale(0%) brightness(1);
  }

  .project-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      rgba(29, 26, 47, 1) 0%,
      rgba(60, 30, 100, 0.4) 100%
    );
    transition: background 0.5s ease;
  }

  .project-item:hover .project-img-placeholder {
    background: linear-gradient(
      135deg,
      rgba(40, 30, 70, 1) 0%,
      rgba(100, 50, 180, 0.4) 100%
    );
  }

  .placeholder-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    opacity: 0.25;
    transition: opacity 0.4s ease;
  }

  .project-item:hover .placeholder-grid {
    opacity: 0.5;
  }

  .grid-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #965fd4;
  }

  .project-visual-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(10, 8, 20, 0.9) 100%
    );
    pointer-events: none;
  }

  .project-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem 1.5rem;
    gap: 0.75rem;
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .project-year {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.25);
    font-family: var(--font-spac, monospace);
    letter-spacing: 0.1em;
  }

  .project-tags-row {
    display: flex;
    gap: 0.4rem;
  }

  .project-tag-pill {
    font-size: 0.6rem;
    padding: 3px 8px;
    border: 1px solid rgba(150, 95, 212, 0.25);
    border-radius: 20px;
    color: rgba(150, 95, 212, 0.7);
    font-family: var(--font-spac, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .project-item:hover .project-tag-pill {
    border-color: rgba(150, 95, 212, 0.5);
    color: rgba(150, 95, 212, 1);
    background: rgba(150, 95, 212, 0.08);
  }

  .project-title {
    font-family: var(--font-garamond, serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    line-height: 1.15;
    font-style: italic;
    transition: color 0.3s ease;
  }

  .project-item:hover .project-title {
    color: #fff;
  }

  .project-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.6;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-spac, monospace);
    transition: color 0.3s ease;
  }

  .project-item:hover .project-desc {
    color: rgba(255, 255, 255, 0.55);
  }

  .project-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cta-text {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
    font-family: var(--font-spac, monospace);
    transition: color 0.3s ease;
  }

  .cta-arrow {
    font-size: 0.9rem;
    color: rgba(150, 95, 212, 0.4);
    transition: all 0.3s ease;
    display: inline-block;
  }

  .project-item:hover .cta-text {
    color: rgba(255, 255, 255, 0.7);
  }
  .project-item:hover .cta-arrow {
    color: #965fd4;
    transform: translateX(4px);
  }

  .track-end-spacer {
    width: 3rem;
    flex-shrink: 0;
  }

  /* ── Progress ─────────────────────────────────────────────────── */
  .scroll-progress-bar {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
    margin: 0 3rem 2rem;
    position: relative;
  }

  .scroll-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: rgba(150, 95, 212, 0.7);
    transition: width 0.1s linear;
  }

  /* ── Scroll hint ─────────────────────────────────────────────── */
  .scroll-hint {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 3rem 2.5rem;
    opacity: 1;
    transition: opacity 0.5s ease;
  }

  .scroll-hint.hidden {
    opacity: 0;
  }

  .scroll-hint span {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.2);
    font-family: var(--font-spac, monospace);
  }

  .hint-arrows {
    display: flex;
    gap: 0.5rem;
    color: rgba(150, 95, 212, 0.4);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .projects-header {
      padding: 3rem 1.5rem 1.5rem;
    }
    .projects-main-title {
      font-size: clamp(3rem, 15vw, 5rem);
    }
    .projects-track-wrapper {
      padding: 1.5rem 1.5rem 2rem;
    }
    .projects-track {
      height: 460px;
    }
    .project-item {
      width: 300px;
    }
    .project-visual {
      height: 200px;
    }
    .scroll-progress-bar,
    .scroll-hint {
      margin-left: 1.5rem;
      margin-right: 1.5rem;
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>

<script>
  (function () {
    const cursor = document.getElementById("projectCursor");
    const section = document.querySelector(".projects-section");
    if (!cursor || !section) return;

    /* ── Cursor smooth follow ──────────────────────────────── */
    let mouseX = 0,
      mouseY = 0;
    let curX = 0,
      curY = 0;
    let rafId: number | null = null;

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function animateCursor() {
      curX = lerp(curX, mouseX, 0.1);
      curY = lerp(curY, mouseY, 0.1);
      (cursor as HTMLElement).style.left = curX + "px";
      (cursor as HTMLElement).style.top = curY + "px";
      rafId = requestAnimationFrame(animateCursor);
    }

    section.addEventListener("mouseenter", () => {
      cursor.classList.add("visible");
      if (!rafId) animateCursor();
    });

    section.addEventListener("mouseleave", () => {
      cursor.classList.remove("visible", "on-card");
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    });

    window.addEventListener(
      "mousemove",
      (e: MouseEvent) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      },
      { passive: true },
    );

    /* "VER" label: solo cuando el mouse está sobre una project-item */
    const cards = section.querySelectorAll(".project-item");
    cards.forEach((card) => {
      card.addEventListener("mouseenter", () =>
        cursor.classList.add("on-card"),
      );
      card.addEventListener("mouseleave", () =>
        cursor.classList.remove("on-card"),
      );
    });

    section.addEventListener("mousedown", () =>
      cursor.classList.add("clicking"),
    );
    window.addEventListener("mouseup", () =>
      cursor.classList.remove("clicking"),
    );

    /* ── Drag-to-scroll con inercia ────────────────────────── */
    const wrapper = section.querySelector(
      ".projects-track-wrapper",
    ) as HTMLElement | null;
    if (!wrapper) return;

    let isDragging = false,
      startX = 0,
      scrollLeft = 0,
      velocity = 0,
      lastX = 0;
    let momentumId: number | null = null;

    wrapper.addEventListener("mousedown", (e: Event) => {
      const me = e as MouseEvent;
      isDragging = true;
      startX = me.pageX - wrapper.offsetLeft;
      scrollLeft = wrapper.scrollLeft;
      lastX = me.pageX;
      velocity = 0;
      if (momentumId) {
        cancelAnimationFrame(momentumId);
        momentumId = null;
      }
    });

    window.addEventListener("mouseup", () => {
      if (!isDragging) return;
      isDragging = false;
      function momentum() {
        if (Math.abs(velocity) < 0.5) return;
        velocity *= 1;
        wrapper!.scrollLeft += velocity;
        momentumId = requestAnimationFrame(momentum);
      }
      momentum();
    });

    window.addEventListener("mousemove", (e: MouseEvent) => {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.pageX - wrapper!.offsetLeft;
      const walk = (x - startX) * 1.5;
      velocity = e.pageX - lastX;
      lastX = e.pageX;
      wrapper!.scrollLeft = scrollLeft - walk;
    });

    /* ── Progress bar ──────────────────────────────────────── */
    const fill = document.getElementById("scrollFill");
    const hint = document.getElementById("scrollHint");
    let hinted = false;

    wrapper.addEventListener("scroll", () => {
      if (!fill) return;
      const max = wrapper.scrollWidth - wrapper.clientWidth;
      const pct = max > 0 ? (wrapper.scrollLeft / max) * 100 : 0;
      fill.style.width = pct + "%";
      if (!hinted && pct > 5 && hint) {
        hint.classList.add("hidden");
        hinted = true;
      }
    });

    /* ── Touch ─────────────────────────────────────────────── */
    let touchStartX = 0;
    wrapper.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        touchStartX = e.touches[0].clientX;
      },
      { passive: true },
    );
    wrapper.addEventListener(
      "touchmove",
      (e: TouchEvent) => {
        const dx = touchStartX - e.touches[0].clientX;
        wrapper!.scrollLeft += dx * 0.5;
        touchStartX = e.touches[0].clientX;
      },
      { passive: true },
    );
  })();
</script>
