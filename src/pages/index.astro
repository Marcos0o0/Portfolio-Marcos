<script>
  /*
   * Marquee reactivo al scroll:
   * - Velocidad base muy lenta (0.4 px/frame ≈ 24fps)
   * - Cuando bajas: acelera en dirección normal
   * - Cuando subes: invierte dirección
   * - Al parar: vuelve suavemente a la base
   */
  (function () {
    const marquees = document.querySelectorAll("[data-marquee]");

    marquees.forEach((el) => {
      const inner = el.querySelector(".marquee-inner") as HTMLElement | null;
      if (!inner) return;

      const baseSpeed = parseFloat(
        (el as HTMLElement).dataset.baseSpeed ?? "0.4",
      );
      let currentSpeed = baseSpeed;
      let targetSpeed = baseSpeed;
      let direction = 1;

      // Triplicar contenido para tener margen a ambos lados al retroceder
      const clone = inner.innerHTML;
      inner.innerHTML = clone + clone + clone;
      const totalW = inner.scrollWidth / 3;

      // Empezar en la copia del centro para soportar reversa inmediata
      let offset = totalW;

      let lastScrollY = window.scrollY;
      let scrollVel = 0;

      window.addEventListener(
        "scroll",
        () => {
          const dy = window.scrollY - lastScrollY;
          lastScrollY = window.scrollY;

          if (dy > 0) {
            direction = 1;
          } else if (dy < 0) {
            direction = -1;
          }

          scrollVel = Math.abs(dy) * 0.1;
        },
        { passive: true },
      );

      function tick() {
        // Decaimiento de la velocidad del scroll
        scrollVel *= 0.88;

        // targetSpeed: base ajustada por dirección + empuje del scroll
        const speedBaseDir = baseSpeed * direction;
        const speedImpulse = Math.sign(baseSpeed) * direction * scrollVel;

        targetSpeed = speedBaseDir + speedImpulse;

        // Lerp hacia targetSpeed para transición suave
        currentSpeed += (targetSpeed - currentSpeed) * 0.06;

        offset += currentSpeed;

        // Loop seguro: mantenemos el offset dentro de la zona duplicada
        if (offset >= totalW * 2) offset -= totalW;
        if (offset <= 0) offset += totalW;

        inner.style.transform = `translateX(${-offset}px)`;
        requestAnimationFrame(tick);
      }

      tick();
    });
  })();
</script>

<script>
  /* ══════════════════════════════════════════════════════════
   *  HERO SPOTLIGHT — Proximity glow on SVG text
   * ══════════════════════════════════════════════════════════ */
  (function () {
    const heroSection = document.getElementById("home");
    const spotlight = document.getElementById("heroSpotlight");
    if (!heroSection || !spotlight) return;

    let targetX = 0,
      targetY = 0;
    let currentX = 0,
      currentY = 0;
    let isActive = false;
    let rafId: number | null = null;

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function animate() {
      currentX = lerp(currentX, targetX, 0.08);
      currentY = lerp(currentY, targetY, 0.08);
      spotlight.style.left = currentX + "px";
      spotlight.style.top = currentY + "px";
      if (isActive) {
        rafId = requestAnimationFrame(animate);
      }
    }

    heroSection.addEventListener("mousemove", (e: MouseEvent) => {
      const rect = heroSection.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
      if (!isActive) {
        isActive = true;
        spotlight.style.opacity = "1";
        animate();
      }
    });

    heroSection.addEventListener("mouseleave", () => {
      isActive = false;
      spotlight.style.opacity = "0";
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    });
  })();
</script>

<script>
  /* ══════════════════════════════════════════════════════════
   *  GLOBAL MICRO-ANIMATIONS
   *  Scroll-reveal, magnetic hover, stagger effects
   * ══════════════════════════════════════════════════════════ */
  (function () {
    /* ── 1. Scroll-Reveal ──────────────────────────────────── */
    const revealEls = document.querySelectorAll("[data-reveal]");
    if (revealEls.length) {
      revealEls.forEach((el) => {
        const htmlEl = el as HTMLElement;
        htmlEl.style.opacity = "0";
        htmlEl.style.transform = "translateY(40px)";
        htmlEl.style.transition =
          "opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1)";
      });

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const delay = el.dataset.revealDelay || "0";
              setTimeout(() => {
                el.style.opacity = "1";
                el.style.transform = "translateY(0)";
              }, parseInt(delay));
              revealObserver.unobserve(el);
            }
          });
        },
        { threshold: 0.1, rootMargin: "-50px 0px" },
      );

      revealEls.forEach((el) => revealObserver.observe(el));
    }

    /* ── 2. Magnetic Hover on interactive elements ─────────── */
    const magneticEls = document.querySelectorAll("[data-magnetic]");
    magneticEls.forEach((el) => {
      const htmlEl = el as HTMLElement;
      const strength = parseFloat(htmlEl.dataset.magnetic || "8");

      htmlEl.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = htmlEl.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width - 0.5) * strength * 2;
        const y = ((e.clientY - rect.top) / rect.height - 0.5) * strength * 2;
        htmlEl.style.transform = `translate(${x}px, ${y}px)`;
        htmlEl.style.transition = "transform 0.2s ease-out";
      });

      htmlEl.addEventListener("mouseleave", () => {
        htmlEl.style.transform = "";
        htmlEl.style.transition =
          "transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)";
      });
    });

    /* ── 3. Stagger-reveal for groups ──────────────────────── */
    const staggerGroups = document.querySelectorAll("[data-stagger]");
    staggerGroups.forEach((group) => {
      const children = group.children;
      Array.from(children).forEach((child, i) => {
        const el = child as HTMLElement;
        el.style.opacity = "0";
        el.style.transform = "translateY(20px) scale(0.95)";
        el.style.transition = `opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${i * 60}ms, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) ${i * 60}ms`;
      });

      const staggerObs = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            Array.from(children).forEach((child) => {
              const el = child as HTMLElement;
              el.style.opacity = "1";
              el.style.transform = "translateY(0) scale(1)";
            });
            staggerObs.unobserve(entry.target);
          }
        },
        { threshold: 0.15 },
      );

      staggerObs.observe(group);
    });

    /* ── 4. Section title clip-reveal ──────────────────────── */
    const clipEls = document.querySelectorAll("[data-clip-reveal]");
    clipEls.forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.style.clipPath = "inset(100% 0 0 0)";
      htmlEl.style.transition = "clip-path 1s cubic-bezier(0.16, 1, 0.3, 1)";

      const clipObs = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            htmlEl.style.clipPath = "inset(0 0 0 0)";
            clipObs.unobserve(htmlEl);
          }
        },
        { threshold: 0.1 },
      );

      clipObs.observe(htmlEl);
    });

    /* ── 5. CTA shimmer effect ─────────────────────────────── */
    const shimmerBtns = document.querySelectorAll(".cta-button");
    shimmerBtns.forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.style.position = "relative";
      htmlBtn.style.overflow = "hidden";
      const shimmer = document.createElement("div");
      shimmer.style.cssText = `
        position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
        animation: shimmer-sweep 3s ease-in-out infinite;
        pointer-events: none; z-index: 1;
      `;
      htmlBtn.appendChild(shimmer);
    });

    // Add shimmer keyframes
    const shimmerStyle = document.createElement("style");
    shimmerStyle.textContent = `
      @keyframes shimmer-sweep {
        0%, 100% { left: -100%; }
        50% { left: 150%; }
      }
    `;
    document.head.appendChild(shimmerStyle);
  })();
</script>
