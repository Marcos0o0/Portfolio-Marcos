---
import Layout from "../layouts/Layout.astro";
import { FadeContent } from "@/components/ui/FadeContent.jsx";
import { PillNav } from "@/components/ui/PillNav.jsx";
import ProjectsSection from "@/components/ProjectsSection.astro";
import AboutMe from "@/components/AboutMe.astro";
import Footer from "@/components/Footer.astro";
import MeshGradient from "../components/MeshGradient.astro";

const projects = [
  {
    titulo: "Proyecto Uno",
    descripcion: "Proyecto 1",
    tags: ["React", "Tailwind", "TypeScript"],
    imagen: "",
    enlace: "#",
    año: "2024",
  },
];
---

<style>
  /* ── Logo animado — paused until loader finishes ────────── */
  .logo-stroke {
    fill: none;
    stroke: #965fd4;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 8000;
    stroke-dashoffset: 8000;
    animation: draw 4s ease-in-out forwards;
    animation-play-state: paused;
    filter: drop-shadow(0 0 8px rgba(150, 95, 212, 0.6));
  }
  html.loader-finished .logo-stroke {
    animation-play-state: running;
  }
  .logo-fill {
    fill: #965fd4;
    stroke: none;
    opacity: 0;
    animation: fadeIn 1s ease-in forwards 2s;
    animation-play-state: paused;
  }
  html.loader-finished .logo-fill {
    animation-play-state: running;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  /* ── Marquee ──────────────────────────────────────────────── */
  .section-marquee {
    background: #0f0c1f;
    border-left: 10px solid #0e0c16;
    border-right: 10px solid #0e0c16;
    overflow: hidden;
    padding: 1rem 0;
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    cursor: default;
  }

  .marquee-inner {
    display: flex;
    white-space: nowrap;
    /* JS controlará el transform — no CSS animation aquí */
    will-change: transform;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    padding: 0 2rem;
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #fff;
    font-family: var(--font-spac, monospace);
    flex-shrink: 0;
  }

  .marquee-star {
    margin-left: 4rem;
    color: rgba(255, 255, 255, 0.6);
    flex-shrink: 0;
  }

  /* ── Hero spotlight effect ── */
  .hero-spotlight {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(150, 95, 212, 0.25) 0%,
      rgba(150, 95, 212, 0.08) 35%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 12;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.5s ease;
    mix-blend-mode: screen;
    filter: blur(10px);
    will-change: left, top;
  }

  /* ── Scroll indicator ── */
  .scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    transition: opacity 0.8s ease 0.5s;
  }

  html.loader-finished .scroll-indicator {
    opacity: 1;
  }

  .scroll-indicator-text {
    font-family: var(--font-spac, monospace);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
  }

  .scroll-indicator-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(
      to bottom,
      rgba(150, 95, 212, 0.6),
      transparent
    );
    animation: scroll-bob 2s ease-in-out infinite;
  }

  @keyframes scroll-bob {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(10px);
      opacity: 0.4;
    }
  }
</style>

<Layout>
  <div class="relative flex items-center justify-center">
    <PillNav
      client:load
      logo="/Sparkle.svg"
      onMobileMenuClick={() => {}}
      initialLoadAnimation={true}
      waitForLoader={true}
      items={[
        { href: "#home", label: "Home" },
        { href: "#projects", label: "Projects" },
        { href: "#about", label: "About" },
        { href: "#contact", label: "Contact" },
      ]}
      activeHref={Astro.url.pathname}
    />
  </div>

  <main class="relative">
    <!-- ══ HERO ════════════════════════════════════════════════ -->
    <section
      id="home"
      class="relative bg-base border-x-10 border-t-13 border-[#0e0c16] h-screen flex justify-center items-center overflow-hidden"
    >
      <MeshGradient />
      <div class="hero-spotlight" id="heroSpotlight"></div>
      <div class="relative z-10">
        <FadeContent
